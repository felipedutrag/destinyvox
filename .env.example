# DestinyVox Landing Page — Environment Variables Template
# Copy to .env.local for local development (never commit .env.local)

# ─── Stripe (client-side — exposed to browser) ─────────────────────────────
# Payment Links — get from Stripe Dashboard > Payment Links
NEXT_PUBLIC_STRIPE_LINK_ESSENTIAL=https://buy.stripe.com/test_replace_me
NEXT_PUBLIC_STRIPE_LINK_VIP=https://buy.stripe.com/test_replace_me

# ─── Stripe (server-side — NEVER expose to browser) ────────────────────────
# Secret key — from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret — from Stripe Dashboard > Webhooks > your endpoint
# Or from `stripe listen --print-secret` in Stripe CLI for local testing
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Supabase (server-side — NEVER expose to browser) ──────────────────────
# Project URL — from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — from Supabase Dashboard > Project Settings > API
# WARNING: This key bypasses Row Level Security. Server-side only!
SUPABASE_SERVICE_ROLE_KEY=eyJ_REPLACE_ME
